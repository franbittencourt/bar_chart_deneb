{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Colunas Agrupadas Dinâmicas para Deneb (Power BI). Toggle Mensal/Acumulado interno + cross-filtering.",

  "config": {
    "locale": {
      "number": {
        "decimal": ",",
        "thousands": ".",
        "grouping": [3],
        "currency": ["R$ ", ""]
      }
    }
  },

  "signals": [
    {"name": "campoMes",  "value": "Ano_Mes_abrev"},
    {"name": "campoPlan", "value": "m_Plan"},
    {"name": "campoReal", "value": "m_Real"},
    {"name": "campoProj", "value": "m_Proj"},
    {"name": "labelPlan", "value": "Planejado"},
    {"name": "labelReal", "value": "Realizado"},
    {"name": "labelProj", "value": "Projetado"},
    {"name": "corPlan",   "value": "#4472C4"},
    {"name": "corReal",   "value": "#70AD47"},
    {"name": "corProj",   "value": "#ED7D31"},
    {"name": "paddingGrupo",   "value": 0.3},
    {"name": "paddingBarra",   "value": 0.05},
    {"name": "raioAresta",     "value": 3},
    {"name": "mostrarRotulos", "value": true},
    {"name": "tamanhoRotulo",  "value": 8},
    {"name": "fontePadrao",    "value": "Segoe UI, sans-serif"},
    {"name": "alturaHeader",   "value": 58},

    {
      "name": "_crossFilter",
      "description": "Cross-filter de saída. Requer modo Advanced habilitado nas configurações do Deneb (Interatividade > Habilitar seleção > Avançado). Constrói a expressão de filtro explicitamente pois os dados são derivados (união + filtros) e o modo simples não consegue resolver a identidade da linha original.",
      "value": null,
      "on": [
        {
          "events": [
            {"markname": "barra",  "type": "click"},
            {"markname": "rotulo", "type": "click"}
          ],
          "update": "pbiCrossFilterApply(event, \"datum['\" + campoMes + \"'] == '\" + datum._mes + \"'\")"
        }
      ]
    },

    {
      "name": "modoAcumulado",
      "value": false,
      "on": [
        {
          "events": [
            {"markname": "btn_mensal_rect", "type": "click"},
            {"markname": "btn_mensal_txt",  "type": "click"}
          ],
          "update": "false"
        },
        {
          "events": [
            {"markname": "btn_acum_rect", "type": "click"},
            {"markname": "btn_acum_txt",  "type": "click"}
          ],
          "update": "true"
        }
      ]
    }
  ],

  "data": [
    {
      "name": "dataset"
    },
    {
      "name": "proc",
      "source": "dataset",
      "transform": [
        {"type": "formula", "as": "_mes",  "expr": "datum[campoMes]"},
        {"type": "formula", "as": "_plan", "expr": "datum[campoPlan]"},
        {"type": "formula", "as": "_real", "expr": "datum[campoReal]"},
        {"type": "formula", "as": "_proj", "expr": "datum[campoProj]"},
        {
          "type": "formula",
          "as": "_exec",
          "expr": "(isValid(datum[campoReal]) && datum[campoReal] !== null ? datum[campoReal] : 0) + (isValid(datum[campoProj]) && datum[campoProj] !== null ? datum[campoProj] : 0)"
        },
        {
          "type": "window",
          "ops": ["sum", "sum"],
          "fields": ["_plan", "_exec"],
          "as":     ["_plan_acum", "_exec_acum"],
          "frame":  [null, 0]
        }
      ]
    },
    {
      "name": "bars_plan",
      "source": "proc",
      "transform": [
        {"type": "formula", "as": "serie", "expr": "labelPlan"},
        {"type": "formula", "as": "valor", "expr": "modoAcumulado ? datum._plan_acum : datum._plan"},
        {"type": "formula", "as": "ordem", "expr": "0"}
      ]
    },
    {
      "name": "bars_real",
      "source": "proc",
      "transform": [
        {"type": "filter",  "expr": "isValid(datum._real) && datum._real !== null"},
        {"type": "formula", "as": "serie", "expr": "labelReal"},
        {"type": "formula", "as": "valor", "expr": "modoAcumulado ? datum._exec_acum : datum._real"},
        {"type": "formula", "as": "ordem", "expr": "1"}
      ]
    },
    {
      "name": "bars_proj",
      "source": "proc",
      "transform": [
        {"type": "filter",  "expr": "isValid(datum._proj) && datum._proj !== null"},
        {"type": "formula", "as": "serie", "expr": "labelProj"},
        {"type": "formula", "as": "valor", "expr": "modoAcumulado ? datum._exec_acum : datum._proj"},
        {"type": "formula", "as": "ordem", "expr": "1"}
      ]
    },
    {
      "name": "bars",
      "source": ["bars_plan", "bars_real", "bars_proj"],
      "transform": [
        {
          "type": "joinaggregate",
          "groupby": ["_mes"],
          "ops": ["sum", "count"],
          "fields": ["valor", "valor"],
          "as": ["_soma_mes", "_n_mes"]
        },
        {"type": "formula", "as": "_valor_irmao", "expr": "datum._soma_mes - datum.valor"}
      ]
    }
  ],

  "scales": [
    {
      "name": "xscale",
      "type": "band",
      "domain": {"data": "bars_plan", "field": "_mes"},
      "range": "width",
      "padding": {"signal": "paddingGrupo"}
    },
    {
      "name": "xinner",
      "type": "band",
      "domain": [0, 1],
      "range": {"signal": "[0, bandwidth('xscale')]"},
      "padding": {"signal": "paddingBarra"}
    },
    {
      "name": "yscale",
      "type": "linear",
      "domain": {"data": "bars", "field": "valor"},
      "range": [{"signal": "height"}, {"signal": "alturaHeader"}],
      "nice": true,
      "zero": true
    },
    {
      "name": "color",
      "type": "ordinal",
      "domain": {"signal": "[labelPlan, labelReal, labelProj]"},
      "range": {"signal": "[corPlan, corReal, corProj]"}
    }
  ],

  "axes": [
    {
      "orient": "bottom",
      "scale": "xscale",
      "domain": false,
      "ticks": false,
      "labelPadding": 10,
      "labelFont": "Segoe UI, sans-serif",
      "labelFontSize": 11,
      "labelColor": "#404040",
      "labelAngle": -35,
      "labelAlign": "right",
      "labelBaseline": "middle",
      "labelOverlap": false
    },
    {
      "orient": "left",
      "scale": "yscale",
      "domain": false,
      "ticks": false,
      "tickCount": 5,
      "grid": true,
      "gridColor": "#e8e8e8",
      "gridOpacity": 1,
      "labelFont": "Segoe UI, sans-serif",
      "labelFontSize": 11,
      "labelColor": "#666666",
      "format": "$,.0f",
      "labelOverlap": "greedy"
    }
  ],

  "legends": [
    {
      "fill": "color",
      "orient": "bottom",
      "direction": "horizontal",
      "padding": 12,
      "columnPadding": 24,
      "symbolType": "square",
      "symbolSize": 120,
      "symbolStrokeWidth": 0,
      "labelFont": "Segoe UI, sans-serif",
      "labelFontSize": 12,
      "labelColor": "#404040"
    }
  ],

  "marks": [
    {
      "type": "group",
      "description": "Toggle Mensal / Acumulado — renderiza na área de padding superior.",
      "encode": {
        "enter": {
          "x":      {"signal": "width - 162"},
          "y":      {"value": 8},
          "width":  {"value": 157},
          "height": {"value": 24},
          "clip":   {"value": false}
        }
      },
      "marks": [
        {
          "type": "rect",
          "encode": {
            "enter": {
              "x": {"value": 0}, "y": {"value": 0},
              "width": {"value": 157}, "height": {"value": 24},
              "cornerRadius": {"value": 12},
              "fill": {"value": "#dde1e7"}
            }
          }
        },
        {
          "type": "rect",
          "encode": {
            "update": {
              "x":            {"signal": "modoAcumulado ? 79 : 0"},
              "y":            {"value": 0},
              "width":        {"value": 78},
              "height":       {"value": 24},
              "cornerRadius": {"value": 12},
              "fill":         {"value": "#4472C4"}
            }
          }
        },
        {
          "type": "text",
          "name": "btn_mensal_txt",
          "encode": {
            "update": {
              "x": {"value": 39}, "y": {"value": 12},
              "align": {"value": "center"}, "baseline": {"value": "middle"},
              "text": {"value": "Mensal"},
              "fill": {"signal": "modoAcumulado ? '#666666' : '#ffffff'"},
              "font": {"value": "Segoe UI, sans-serif"},
              "fontSize": {"value": 11}, "fontWeight": {"value": "600"},
              "cursor": {"value": "pointer"}
            }
          }
        },
        {
          "type": "text",
          "name": "btn_acum_txt",
          "encode": {
            "update": {
              "x": {"value": 118}, "y": {"value": 12},
              "align": {"value": "center"}, "baseline": {"value": "middle"},
              "text": {"value": "Acumulado"},
              "fill": {"signal": "modoAcumulado ? '#ffffff' : '#666666'"},
              "font": {"value": "Segoe UI, sans-serif"},
              "fontSize": {"value": 11}, "fontWeight": {"value": "600"},
              "cursor": {"value": "pointer"}
            }
          }
        },
        {
          "type": "rect",
          "name": "btn_mensal_rect",
          "encode": {
            "enter": {
              "x": {"value": 0}, "y": {"value": 0},
              "width": {"value": 79}, "height": {"value": 24},
              "fill": {"value": "#000000"}, "fillOpacity": {"value": 0.001},
              "cursor": {"value": "pointer"}
            }
          }
        },
        {
          "type": "rect",
          "name": "btn_acum_rect",
          "encode": {
            "enter": {
              "x": {"value": 79}, "y": {"value": 0},
              "width": {"value": 78}, "height": {"value": 24},
              "fill": {"value": "#000000"}, "fillOpacity": {"value": 0.001},
              "cursor": {"value": "pointer"}
            }
          }
        }
      ]
    },

    {
      "type": "group",
      "from": {
        "facet": {
          "data": "bars",
          "name": "bars_por_mes",
          "groupby": "_mes"
        }
      },
      "encode": {
        "enter": {
          "x":      {"scale": "xscale", "field": "_mes"},
          "width":  {"signal": "bandwidth('xscale')"},
          "height": {"signal": "height"},
          "clip":   {"value": false}
        }
      },
      "marks": [
        {
          "type": "rect",
          "name": "barra",
          "from": {"data": "bars_por_mes"},
          "encode": {
            "update": {
              "x":                    {"scale": "xinner", "field": "ordem"},
              "width":                {"signal": "bandwidth('xinner')"},
              "y":                    {"scale": "yscale", "field": "valor"},
              "y2":                   {"scale": "yscale", "value": 0},
              "fill":                 {"scale": "color",  "field": "serie"},
              "cornerRadiusTopLeft":  {"signal": "raioAresta"},
              "cornerRadiusTopRight": {"signal": "raioAresta"},
              "fillOpacity": [
                {"test": "datum.__selected__ == 'off'", "value": 0.15},
                {"value": 1}
              ],
              "cursor": {"value": "pointer"},
              "tooltip": {
                "signal": "{'Mês': datum._mes, 'Tipo': datum.serie, 'Modo': modoAcumulado ? 'Acumulado' : 'Mensal', 'Valor': format(datum.valor, '$,.0f')}"
              }
            },
            "hover": {
              "fillOpacity": [
                {"test": "datum.__selected__ == 'off'", "value": 0.25},
                {"value": 0.75}
              ]
            }
          }
        },
        {
          "type": "text",
          "name": "rotulo",
          "description": "Rótulo de valor. Anti-colisão: quando as duas barras do mês quase empatam, o rótulo da 2ª barra vai para DENTRO da barra (branco) — nunca sobe em direção ao botão. Fallback para barras curtas: sobe acima do rótulo vizinho.",
          "from": {"data": "bars_por_mes"},
          "encode": {
            "update": {
              "x":          {"signal": "scale('xinner', datum.ordem) + bandwidth('xinner') / 2"},
              "y": {
                "signal": "datum.ordem == 1 && datum._n_mes == 2 && abs(scale('yscale', datum.valor) - scale('yscale', datum._valor_irmao)) < tamanhoRotulo + 4 ? ((scale('yscale', 0) - scale('yscale', datum.valor)) > tamanhoRotulo + 12 ? scale('yscale', datum.valor) + tamanhoRotulo + 5 : min(scale('yscale', datum.valor), scale('yscale', datum._valor_irmao)) - tamanhoRotulo - 7) : scale('yscale', datum.valor) - 5"
              },
              "align":      {"value": "center"},
              "baseline":   {"value": "bottom"},
              "font":       {"value": "Segoe UI, sans-serif"},
              "fontSize":   {"signal": "tamanhoRotulo"},
              "fontWeight": {"value": "600"},
              "fill": {
                "signal": "datum.ordem == 1 && datum._n_mes == 2 && abs(scale('yscale', datum.valor) - scale('yscale', datum._valor_irmao)) < tamanhoRotulo + 4 && (scale('yscale', 0) - scale('yscale', datum.valor)) > tamanhoRotulo + 12 ? '#ffffff' : '#404040'"
              },
              "cursor":     {"value": "pointer"},
              "text": {
                "signal": "mostrarRotulos ? (datum.valor >= 10000000 ? format(datum.valor / 1000000, ',.0f') + 'M' : (datum.valor >= 1000000 ? format(datum.valor / 1000000, ',.1f') + 'M' : format(datum.valor / 1000, ',.0f') + 'K')) : ''"
              },
              "opacity": [
                {"test": "datum.__selected__ == 'off'", "value": 0.15},
                {"value": 1}
              ]
            }
          }
        }
      ]
    }
  ]
}
